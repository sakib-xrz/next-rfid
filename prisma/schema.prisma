generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CourseType {
  DIPLOMA
  BACHELOR
  M_SC
  PHD

  @@map("course_type")
}

enum RoleType {
  STUDENT
  LECTURER
  STAFF
  VISITOR
  ADMIN

  @@map("role_type")
}

enum StatusType {
  PENDING
  ACTIVE
  INACTIVE
  REJECTED

  @@map("status_type")
}

enum ActionType {
  IN
  OUT

  @@map("action_type")
}

model User {
  id                String      @id @default(uuid()) @db.Uuid
  idFromInstitution String      @unique @map("id_from_institution")
  name              String
  email             String      @unique
  phone             String
  carNumber         String      @map("car_number")
  course            CourseType?
  role              RoleType    @default(STUDENT)
  licenseFrontUrl   String      @map("license_front_url")
  licenseBackUrl    String      @map("license_back_url")
  rfidNumber        String?     @unique @map("rfid_number") @db.VarChar(24)
  status            StatusType  @default(PENDING)
  passwordHash      String?     @map("password_hash")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  logs              Log[]
  sessions          Session[]

  @@index([status])
  @@index([rfidNumber])
  @@index([idFromInstitution])
  @@map("users")
}

model ScanDevice {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  type         ActionType
  location     String
  serialNumber String?    @map("serial_number")
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  logs         Log[]
  sessions     Session[]

  @@map("scan_devices")
}

model Log {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  action    ActionType
  deviceId  String?     @map("device_id") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  device    ScanDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([deviceId])
  @@index([createdAt(sort: Desc)])
  @@map("logs")
}

model Session {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  inTime    DateTime    @map("in_time") @db.Timestamptz(6)
  outTime   DateTime?   @map("out_time") @db.Timestamptz(6)
  totalTime Int?        @map("total_time")
  deviceId  String?     @map("device_id") @db.Uuid
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  device    ScanDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([deviceId])
  @@index([outTime])
  @@map("sessions")
}
