# Gate control (per station PC)
GATE_CONTROL_ENABLED=true
GATE_CONTROL_STATION_ID=boys-hostel-gate
GATE_RELAY_BAUD_RATE=9600
GATE_OPEN_PULSE_MS=2000

# RFID reader
RFID_READER_ENABLED=true
RFID_BAUD_RATE=57600
RFID_DEDUPE_MS=10000

# Database
DATABASE_URL=postgresql://user:password@db-host:5432/next-rfid
AUTH_SECRET=change-me
